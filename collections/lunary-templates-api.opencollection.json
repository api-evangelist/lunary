{
  "opencollection": "1.0.0",
  "info": {
    "name": "Lunary Analytics Templates API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
